APP_NAME=Meridin
APP_VERSION=1.0.0
DEBUG=True

HOST=0.0.0.0
PORT=8000

# Application secret for signing/verification
APP_SECRET=your-secret-key-here

# MongoDB (set to empty string or omit if running in stateless ML-only mode)
MONGODB_URI=mongodb+srv://user:password@host:port/dbname?appName=AppName
DATABASE_NAME=meridin
MONGODB_REQUIRED=false

# Redis cache
REDIS_URL=redis://localhost:6379/0

# ML Models
INTENT_MODEL=models/intent_model.pkl
INTENT_VECTORIZER=models/intent_vectorizer.pkl
ENTITY_MODEL=models/entity_model.pkl
ENTITY_VECTORIZER=models/entity_vectorizer.pkl

# Data files
NORMALIZATION_FILE=data/normalization.json
VOCABULARY_FILE=data/vocabulary.json

# OpenRouter (LLM fallback)
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct

# Logging
LOG_LEVEL=INFO

# WhatsApp / Meta (optional)
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
